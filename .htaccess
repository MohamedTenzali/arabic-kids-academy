AddDefaultCharset UTF-8

RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.arabicokids\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?arabicokids\.com$ [NC]
RewriteRule ^ https://arabicokids.com%{REQUEST_URI} [R=301,L]

RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

AddType "text/html; charset=UTF-8" .html
AddType "text/css; charset=UTF-8" .css
AddType "text/javascript; charset=UTF-8" .js
AddType "application/json; charset=UTF-8" .json
AddType "image/svg+xml; charset=UTF-8" .svg
AddType "text/plain; charset=UTF-8" .txt
AddType "application/xml; charset=UTF-8" .xml
